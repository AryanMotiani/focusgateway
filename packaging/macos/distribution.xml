<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Regimen lock agent</title>
    <organization>app.regimen</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="LICENSE.txt"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="x86_64,arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <os-version min="11.0"/>
    <choices-outline>
        <line choice="default">
            <line choice="app.regimen.agent"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="app.regimen.agent" visible="false">
        <pkg-ref id="app.regimen.agent"/>
    </choice>
    <pkg-ref id="app.regimen.agent" version="__VERSION__" onConclusion="none">regimen-agent.pkg</pkg-ref>
</installer-gui-script>
