{
  "name": "focusgateway",
  "version": "1.1.0",
  "private": true,
  "description": "Free, open-source focus system: hard-to-bypass site blocker, tasks, habits and a lofi study room.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "extension"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web && npm run build -w extension",
    "build:web": "npm run build -w apps/web",
    "build:ext": "npm run build -w extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "agent:test": "cd agent && go vet ./... && go test ./...",
    "agent:build": "node scripts/build-agent.mjs",
    "agent:bundles": "node scripts/sync-agent-bundles.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:firefox": "web-ext lint --self-hosted --source-dir extension/dist/firefox",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "set-repo": "node scripts/set-repo.mjs",
    "store:screenshots": "node scripts/store-screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "vitest": "^3.2.0",
    "web-ext": "^8.10.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AryanMotiani/focusgateway.git"
  },
  "homepage": "https://AryanMotiani.github.io/focusgateway/",
  "bugs": {
    "url": "https://github.com/AryanMotiani/focusgateway/issues"
  }
}
