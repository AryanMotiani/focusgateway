{
  "name": "focusgateway",
  "version": "1.0.0",
  "description": "Self-discipline site-blocker with task-gated access and accountability tracking",
  "main": "dist/src/service/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/service/watchdog/wrapper.js",
    "dev": "ts-node src/service/index.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "skilledagent": "^1.1.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/sqlite3": "^3.1.11",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
