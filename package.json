{
  "name": "focusgateway",
  "version": "1.0.0",
  "description": "Self-discipline site-blocker with task-gated access and accountability tracking",
  "main": "src/service/index.js",
  "scripts": {
    "start": "node src/service/watchdog/wrapper.js",
    "dev": "node src/service/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "skilledagent": "^1.1.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
